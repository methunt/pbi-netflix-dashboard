model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup Measure

	annotation PBI_QueryGroupOrder = 0

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["Netflix","Measure","Last refreshed","Date","dim Title"]

annotation PBI_ProTooling = ["DevMode","MCP-PBIModeling"]

ref table Date
ref table 'Last refreshed'
ref table Measure
ref table Netflix
ref table 'Dim Title'

ref cultureInfo en-US

