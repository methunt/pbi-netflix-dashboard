table Measure
	lineageTag: aa9fb664-356c-41e7-9172-9f6d0a7b53ac

	measure 'Total Movies' = CALCULATE(DISTINCTCOUNT(Netflix[Title]), Netflix[Type] = "Movie")
		formatString: #,0
		displayFolder: Summary
		lineageTag: e40a87e0-e28a-4766-b320-ac5a5286aaa3

		changedProperty = FormatString

	measure 'Total TV Shows' = CALCULATE(DISTINCTCOUNT(Netflix[Title]), Netflix[Type] = "TV Show")
		formatString: #,0
		displayFolder: Summary
		lineageTag: adafcc63-51d1-48f3-b981-4ca1c7b071ae

		changedProperty = FormatString

	measure 'Total Genre in Movies' = CALCULATE(DISTINCTCOUNT(Netflix[Genre]), Netflix[Type] = "Movie")
		formatString: #,0
		displayFolder: Summary
		lineageTag: 1541c116-0474-476f-b9f3-5072f84bfe8c

		changedProperty = FormatString

	measure 'Total Genre in TV Shows' = CALCULATE(DISTINCTCOUNT(Netflix[Genre]), Netflix[Type] = "TV Show")
		formatString: #,0
		displayFolder: Summary
		lineageTag: cdb169cb-6b11-4296-a466-ab5f9a92e620

		changedProperty = FormatString

	measure 'Top 10 Director' = CALCULATE(DISTINCTCOUNT(Netflix[Title]), KEEPFILTERS(Netflix[Director] <>BLANK()))
		formatString: #,0
		displayFolder: Summary
		lineageTag: 57b489a1-79ce-4878-b11a-31983cd519c1

		changedProperty = FormatString

	measure Measure = DISTINCTCOUNT(Netflix[Title])
		formatString: 0
		lineageTag: 0c06ffaf-b31f-410f-96de-4c311a1126f4

	measure 'Average Movies by Rating' = CALCULATE(AVERAGEX(VALUES(Netflix[Rating]), [Total Movies]), KEEPFILTERS(Netflix[Rating] <> BLANK()))
		formatString: 0
		displayFolder: Movies
		lineageTag: e894106d-ffeb-48c4-aaa3-9637dac94528

		changedProperty = FormatString

	measure 'Average Movies by Country' = CALCULATE(AVERAGEX(VALUES(Netflix[Country]), [Total Movies]), KEEPFILTERS(Netflix[Country] <> BLANK()))
		formatString: #,0
		displayFolder: Movies
		lineageTag: 81ae1430-94c4-444a-84a1-299d273b0b8e

		changedProperty = FormatString

	measure 'Average Movies by Genre' = CALCULATE(AVERAGEX(VALUES(Netflix[Genre]), [Total Movies]), KEEPFILTERS(Netflix[Genre] <> BLANK()))
		formatString: #,0
		displayFolder: Movies
		lineageTag: b02475f7-f9ab-420c-a7ed-13fe67420155

		changedProperty = FormatString

	measure 'Most movies added to Netflix in which year' = CONCATENATEX(FILTER(ALLSELECTED('Date'[Year]), RANKX(ALLSELECTED('Date'[Year]), [Total Movies],,DESC,Dense)=1), 'Date'[Year], " , ")
		displayFolder: Movies
		lineageTag: e077fdba-7fde-4b7a-81e0-a3abe3c68255

	measure 'Average TV Shows by Rating' = CALCULATE(AVERAGEX(VALUES(Netflix[Rating]), [Total TV Shows]), KEEPFILTERS(Netflix[Rating] <> BLANK()))
